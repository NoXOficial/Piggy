-- SECCIÓN 1: PIGGY (Invisibilidad, Explosión y Borrado Total)
--------------------------------------------------------------------------------
createSectionTitle("Piggy:", 1)

createButton("Destroy Piggy", Color3.fromRGB(180, 50, 50), 2, function()
	local foundPiggy = false
	
	-- Buscamos por la carpeta PiggyNPC o cualquier Humanoid que actúe como bot/enemigo
	for _, descendant in ipairs(Workspace:GetDescendants()) do
		if descendant:IsA("Humanoid") then
			local model = descendant.Parent
			-- Verificamos que no sea el jugador local
			if model and model ~= character and not model:IsDescendantOf(character) then
				if string.find(string.lower(model.Name), "piggy") or string.find(string.lower(descendant.Name), "piggy") or model.Name == "PiggyBot" then
					foundPiggy = true
					
					-- 1. Efecto de Explosión visual en su posición exacta
					local rootPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
					if rootPart then
						local explosion = Instance.new("Explosion")
						explosion.Position = rootPart.Position
						explosion.BlastRadius = 0 -- Daño 0 para que sea solo visual y no rompa nada del mapa
						explosion.BlastPressure = 0
						explosion.Parent = Workspace
					end
					
					-- 2. Volverlo invisible por completo (partes y accesorios)
					for _, part in ipairs(model:GetDescendants()) do
						if part:IsA("BasePart") then
							part.Transparency = 1
							part.CanCollide = false
						elseif part:IsA("Decal") or part:IsA("Texture") then
							part.Transparency = 1
						end
					end
					
					-- 3. Destruir modelo y carpeta contenedora si aplica
					task.delay(0.1, function()
						if model and model.Parent then
							model:Destroy()
						end
					end)
				end
			end
		end
	end

	-- Limpieza extra de la carpeta PiggyNPC por si acaso
	local piggyFolder = Workspace:FindFirstChild("PiggyNPC")
	if piggyFolder then
		piggyFolder:Destroy()
		foundPiggy = true
	end

	if foundPiggy then
		print("💥 Piggy explotó, se volvió invisible y fue eliminado por completo.")
	else
		warn("⚠️ No se encontró ningún bot de Piggy activo en este momento.")
	end
end)

local espEnabled = false
createButton("ESP Piggy (Toggle)", Color3.fromRGB(70, 130, 180), 3, function()
	espEnabled = not espEnabled
	for _, descendant in ipairs(Workspace:GetDescendants()) do
		if descendant:IsA("Humanoid") and descendant.Parent ~= character then
			local model = descendant.Parent
			if string.find(string.lower(model.Name), "piggy") or model.Name == "PiggyBot" then
				local highlight = model:FindFirstChild("PiggyESP")
				if espEnabled then
					if not highlight then
						highlight = Instance.new("Highlight")
						highlight.Name = "PiggyESP"
						highlight.FillColor = Color3.fromRGB(255, 0, 0)
						highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
						highlight.Parent = model
					end
				else
					if highlight then highlight:Destroy() end
				end
			end
		end
	end
end)

