-- Palabras clave incluyendo Hammer, Rope, Bucket, Gun, Ammo, etc.
local targetKeywords = {"Hammer", "Rope", "Bucket", "Key", "Wrench", "Pliers", "Tape", "C4", "Water", "Carrot", "GreenKey", "RedKey", "BlueKey", "YellowKey", "PurpleKey", "OrangeKey", "PinkKey", "Gun", "Ammo", "Bullet"}

local function getPartFromModel(obj)
	if obj:IsA("Model") then
		return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
	elseif obj:IsA("BasePart") then
		return obj
	end
	return nil
end

local function playerHasItem(itemName)
	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		for _, item in ipairs(backpack:GetChildren()) do
			if string.lower(item.Name) == string.lower(itemName) or string.find(string.lower(item.Name), string.lower(itemName)) then
				return true
			end
		end
	end
	if character then
		for _, item in ipairs(character:GetChildren()) do
			if item:IsA("Tool") and (string.lower(item.Name) == string.lower(itemName) or string.find(string.lower(item.Name), string.lower(itemName))) then
				return true
			end
		end
	end
	return false
end

local trackedButtons = {}

local function refreshMapItems()
	for _, btn in pairs(trackedButtons) do
		if btn then btn:Destroy() end
	end
	trackedButtons = {}

	local count = 0
	for _, descendant in ipairs(Workspace:GetDescendants()) do
		local nameLower = string.lower(descendant.Name)
		
		-- Excluir llave blanca vieja
		local isOldWhiteKey = (string.find(nameLower, "whitekey") and (string.find(nameLower, "old") or string.find(nameLower, "chapter1") or string.find(nameLower, "c1")))
		
		if not isOldWhiteKey then
			local matched = false
			for _, keyword in ipairs(targetKeywords) do
				if string.find(nameLower, string.lower(keyword)) then
					matched = true
					break
				end
			end

			if matched then
				local itemName = descendant.Name
				if not playerHasItem(itemName) then
					local part = getPartFromModel(descendant)
					if part and not descendant:IsDescendantOf(character) then
						count += 1
						
						local btn = Instance.new("TextButton")
						btn.Size = UDim2.new(1, 0, 0, 28)
						btn.BackgroundColor3 = Color3.fromRGB(50, 130, 80)
						btn.Text = "Teleport -> " .. itemName
						btn.TextColor3 = Color3.fromRGB(255, 255, 255)
						btn.TextSize = 12
						btn.Font = Enum.Font.Gotham
						btn.LayoutOrder = count
						btn.Parent = mapItemsContainer

						local corner = Instance.new("UICorner")
						corner.CornerRadius = UDim.new(0, 5)
						corner.Parent = btn

						btn.MouseButton1Click:Connect(function()
							if humanoidRootPart and part then
								local currentPos = part.Position
								local safeCFrame = CFrame.new(currentPos) * CFrame.new(0, 0, -3)
								
								local rayOrigin = safeCFrame.Position + Vector3.new(0, 5, 0)
								local rayDirection = Vector3.new(0, -20, 0)
								local raycastParams = RaycastParams.new()
								raycastParams.FilterDescendantsInstances = {character}
								raycastParams.FilterType = Enum.RaycastFilterType.Exclude
								
								local rayResult = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
								
								if rayResult then
									humanoidRootPart.CFrame = CFrame.new(rayResult.Position + Vector3.new(0, 3, 0))
								else
									humanoidRootPart.CFrame = safeCFrame + Vector3.new(0, 3, 0)
								end
							end
						end)

						table.insert(trackedButtons, btn)
					end
				end
			end
		end
	end
end

createButton("🔄 Actualizar Objetos del Mapa", Color3.fromRGB(100, 80, 160), 12, function()
	refreshMapItems()
end)

task.spawn(function()
	task.wait(1)
	refreshMapItems()
end)
